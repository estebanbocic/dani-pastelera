---
import {
  getProducts,
  getLowestPrice,
  formatCLP,
  getDietaryLabel,
  type MedusaProduct,
} from "../lib/medusa";
import "../styles/global.css";
import es from "../i18n/es.json";

let products: MedusaProduct[] = [];
try {
  const data = await getProducts({ limit: 4 });
  products = data.products;
} catch {}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Pastelería saludable, hecha con cariño. Tortas y dulces sin gluten, sin azúcar y veganos." />
    <title>{es.site.name} — {es.site.tagline}</title>
  </head>
  <body class="bg-[#FFF8F0] text-[#3D3028] font-sans">

    <!-- Nav -->
    <nav class="flex justify-between items-center px-6 py-4 bg-white shadow-sm">
      <a href="/" class="text-[#8B6F47] font-bold text-lg no-underline">🧁 {es.site.name}</a>
      <div class="flex gap-6">
        <a href="/" class="text-[#6B5B4E] text-sm no-underline hover:text-[#8B6F47]">Inicio</a>
        <a href="/productos" class="text-[#6B5B4E] text-sm no-underline hover:text-[#8B6F47]">Productos</a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="bg-gradient-to-br from-[#F5D5CB] to-[#FFF8F0] px-6 py-20 md:py-28 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-[#8B6F47] mb-4 leading-tight">
        Pastelería saludable,<br/>hecha con cariño
      </h1>
      <p class="text-lg text-[#6B5B4E] max-w-xl mx-auto mb-8">
        Tortas y dulces sin gluten, sin azúcar y veganos, preparados a pedido para que todos puedan disfrutar.
      </p>
      <a href="/productos" class="inline-block px-8 py-3 bg-[#8B6F47] text-white rounded-xl font-semibold text-base hover:bg-[#7A5F3D] transition-colors no-underline">
        Ver productos
      </a>
    </section>

    <!-- Dietary Category Cards -->
    <section class="max-w-5xl mx-auto px-6 py-16">
      <h2 class="text-2xl font-bold text-[#8B6F47] text-center mb-10">Pastelería para todos</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/productos?cat=sin-gluten" class="group block bg-white rounded-2xl p-8 text-center shadow-sm hover:shadow-md transition-shadow no-underline">
          <div class="text-4xl mb-4">🌾</div>
          <h3 class="text-lg font-bold text-[#3D3028] mb-2 group-hover:text-[#8B6F47]">Sin Gluten</h3>
          <p class="text-sm text-[#6B5B4E]">Productos libres de gluten, aptos para celíacos. Sabor sin restricciones.</p>
        </a>
        <a href="/productos?cat=sin-azucar" class="group block bg-white rounded-2xl p-8 text-center shadow-sm hover:shadow-md transition-shadow no-underline">
          <div class="text-4xl mb-4">🍯</div>
          <h3 class="text-lg font-bold text-[#3D3028] mb-2 group-hover:text-[#8B6F47]">Sin Azúcar</h3>
          <p class="text-sm text-[#6B5B4E]">Endulzados naturalmente, aptos para diabéticos. Dulce sin culpa.</p>
        </a>
        <a href="/productos?cat=vegano" class="group block bg-white rounded-2xl p-8 text-center shadow-sm hover:shadow-md transition-shadow no-underline">
          <div class="text-4xl mb-4">🌿</div>
          <h3 class="text-lg font-bold text-[#3D3028] mb-2 group-hover:text-[#8B6F47]">Vegano</h3>
          <p class="text-sm text-[#6B5B4E]">100% libre de ingredientes animales. Delicioso y consciente.</p>
        </a>
      </div>
    </section>

    <!-- Featured Products -->
    {products.length > 0 && (
      <section class="bg-white py-16">
        <div class="max-w-5xl mx-auto px-6">
          <h2 class="text-2xl font-bold text-[#8B6F47] text-center mb-10">Los más pedidos</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {products.map((product) => {
              const dietaryTags: string[] = product.metadata?.dietary_tags || [];
              const lowestPrice = getLowestPrice(product);
              return (
                <a href={`/productos/${product.handle}`} class="block bg-[#FFF8F0] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all hover:-translate-y-1 no-underline">
                  <div class="h-44 bg-gradient-to-br from-[#F5D5CB] to-[#f0e6dd] flex items-center justify-center text-5xl">🧁</div>
                  <div class="p-4">
                    <h3 class="font-semibold text-sm text-[#3D3028] mb-1">{product.title}</h3>
                    {dietaryTags.length > 0 && (
                      <div class="flex flex-wrap gap-1 mb-2">
                        {dietaryTags.slice(0, 2).map((tag: string) => {
                          const { label, color } = getDietaryLabel(tag);
                          return <span class="text-[0.65rem] font-semibold text-white px-2 py-0.5 rounded-full" style={`background:${color}`}>{label}</span>;
                        })}
                      </div>
                    )}
                    {lowestPrice != null && (
                      <p class="text-[#8B6F47] font-bold"><span class="text-xs font-normal text-[#6B5B4E]">Desde </span>{formatCLP(lowestPrice)}</p>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
          <div class="text-center mt-8">
            <a href="/productos" class="text-[#8B6F47] font-semibold text-sm hover:underline no-underline">Ver todos los productos →</a>
          </div>
        </div>
      </section>
    )}

    <!-- How It Works -->
    <section class="max-w-4xl mx-auto px-6 py-16">
      <h2 class="text-2xl font-bold text-[#8B6F47] text-center mb-10">¿Cómo funciona?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#F5D5CB] flex items-center justify-center text-2xl">1</div>
          <h3 class="font-bold text-[#3D3028] mb-2">Elige tu producto</h3>
          <p class="text-sm text-[#6B5B4E]">Explora nuestro catálogo de tortas, cupcakes, galletas y más.</p>
        </div>
        <div>
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#F5D5CB] flex items-center justify-center text-2xl">2</div>
          <h3 class="font-bold text-[#3D3028] mb-2">Personaliza a tu gusto</h3>
          <p class="text-sm text-[#6B5B4E]">Elige tamaño, relleno, cobertura, decoración y mensaje personalizado.</p>
        </div>
        <div>
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#F5D5CB] flex items-center justify-center text-2xl">3</div>
          <h3 class="font-bold text-[#3D3028] mb-2">Recíbelo en tu puerta</h3>
          <p class="text-sm text-[#6B5B4E]">Elige tu fecha de entrega y recibe tu pedido preparado con cariño.</p>
        </div>
      </div>
    </section>

    <!-- Trust Section -->
    <section class="bg-white py-16">
      <div class="max-w-4xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-3xl mb-3">🌱</div>
          <h3 class="font-bold text-[#3D3028] mb-2">Ingredientes de selección</h3>
          <p class="text-sm text-[#6B5B4E]">Trabajamos con los mejores ingredientes naturales. Sin premezclas, sin aditivos artificiales.</p>
        </div>
        <div>
          <div class="text-3xl mb-3">🤲</div>
          <h3 class="font-bold text-[#3D3028] mb-2">Hecho a mano con amor</h3>
          <p class="text-sm text-[#6B5B4E]">Cada producto es preparado artesanalmente a pedido. Frescura garantizada.</p>
        </div>
        <div>
          <div class="text-3xl mb-3">💚</div>
          <h3 class="font-bold text-[#3D3028] mb-2">Opciones para todos</h3>
          <p class="text-sm text-[#6B5B4E]">Sin gluten, sin azúcar, vegano. Para que nadie se quede sin disfrutar.</p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="px-6 py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-[#8B6F47] mb-4">¿Lista para endulzar tu día?</h2>
      <p class="text-[#6B5B4E] mb-8 max-w-md mx-auto">Haz tu pedido con al menos 48 horas de anticipación y recíbelo preparado especialmente para ti.</p>
      <a href="/productos" class="inline-block px-8 py-3 bg-[#8B6F47] text-white rounded-xl font-semibold text-base hover:bg-[#7A5F3D] transition-colors no-underline">Ver productos</a>
    </section>

    <!-- Footer -->
    <footer class="bg-[#3D3028] text-[#d4c5b5] py-12">
      <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="text-white font-bold text-lg mb-3">🧁 {es.site.name}</h3>
          <p class="text-sm">Pastelería saludable, hecha con cariño. Tortas y dulces sin gluten, sin azúcar y veganos.</p>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3">Navegación</h4>
          <ul class="space-y-2 text-sm list-none p-0">
            <li><a href="/" class="text-[#d4c5b5] no-underline hover:text-white">Inicio</a></li>
            <li><a href="/productos" class="text-[#d4c5b5] no-underline hover:text-white">Productos</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3">Contacto</h4>
          <ul class="space-y-2 text-sm list-none p-0">
            <li>📧 hola@danipastelera.cl</li>
            <li>📱 +56 9 XXXX XXXX</li>
            <li>📍 Santiago, Chile</li>
          </ul>
        </div>
      </div>
      <div class="max-w-5xl mx-auto px-6 mt-8 pt-6 border-t border-[#5a4d42] text-center text-xs text-[#9a8b7d]">
        &copy; 2026 Dani Pastelera — Todos los derechos reservados
      </div>
    </footer>

  </body>
</html>
