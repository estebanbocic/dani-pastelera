---
import "../styles/global.css";
import es from "../i18n/es.json";
import CheckoutIsland from "../components/CheckoutIsland";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Checkout — {es.site.name}</title>
  </head>
  <body class="bg-[#FFF8F0] text-[#3D3028] font-sans min-h-screen">

    <nav class="flex justify-between items-center px-6 py-4 bg-white shadow-sm">
      <a href="/" class="h-14 w-32 overflow-hidden" aria-label={es.site.name}>
        <img
          src="/dani-pastelera-logo.png"
          alt={es.site.name}
          width="500"
          height="500"
          class="h-full w-full object-cover object-[center_35%]"
        />
      </a>
      <div class="flex gap-6">
        <a href="/productos" class="text-[#6B5B4E] text-sm no-underline hover:text-[#8B6F47]">Productos</a>
      </div>
    </nav>

    <div class="max-w-3xl mx-auto px-6 py-8">
      <h1 class="text-2xl font-bold text-[#8B6F47] mb-8">Checkout</h1>
      <CheckoutIsland client:load />
    </div>

  </body>
</html>
